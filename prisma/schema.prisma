datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CITIZEN
  POLICE
  CONSUMER_RIGHTS
  ADMIN
}

enum CrimeType {
  ROBBERY
  BURGLARY
  PHYSICAL_ASSAULT
  EVE_TEASING
  EXTORTION_CHANDABAZI
  CYBER_HARASSMENT
  FRAUD_SCAM
  DOMESTIC_VIOLENCE
  ILLEGAL_DRUGS
  VANDALISM
  BRIBERY_CORRUPTION
  OTHER
}

enum CrimeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  INVESTIGATING
  ACTION_TAKEN
  CLOSED
  REJECTED
}

enum EmergencyType {
  COMMUNAL_TENSION
  BLOCKADE_HARTAL
  PROTEST_RALLY
  FIRE_OUTBREAK
  ACCIDENT_HAZARD
  FLOOD_NATURAL_DISASTER
  PUBLIC_CURFEW
  SECURITY_RED_ALERT
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SOSStatus {
  ACTIVE
  ACKNOWLEDGED
  DISPATCHED
  RESOLVED
}

enum ConsumerIssueType {
  EXCESSIVE_PRICING
  EXPIRED_ITEMS
  WEIGHT_TAMPERING
  HOARDING
  COUNTERFEIT_GOODS
  UNHYGIENIC_FOOD
  REFUSAL_TO_RECEIPT
  OTHER
}

enum ComplaintStatus {
  LODGED
  AUDITING
  HEARING_SCHEDULED
  FINE_IMPOSED
  RESOLVED
  DISMISSED
}

model User {
  id              String         @id @default(uuid())
  nidNumber       String         @unique
  fullName        String
  email           String         @unique
  phone           String
  role            UserRole       @default(CITIZEN)
  badgeNumber     String?
  designation     String?
  department      String?
  stationOrThana  String
  isNIDVerified   Boolean        @default(false)
  passwordHash    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  crimeReports    CrimeReport[]
  sosRequests     SOSRequest[]
  complaints      ConsumerComplaint[]
  auditLogs       AuditLog[]
  notifications   NotificationItem[]

  @@map("users")
}

model CrimeReport {
  id                 String         @id @default(uuid())
  incidentTitle      String
  crimeType          CrimeType
  severity           CrimeSeverity
  description        String
  incidentDate       DateTime
  division           String
  district           String
  thana              String
  address            String
  latitude           Float
  longitude          Float
  evidenceUrls       String[]       @default([])
  anonymous          Boolean        @default(false)
  status             ReportStatus   @default(SUBMITTED)
  assignedOfficerId  String?
  assignedOfficerName String?
  investigationNotes String?
  actionTaken        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crime_reports")
}

model EmergencyAlert {
  id          String         @id @default(uuid())
  title       String
  message     String
  type        EmergencyType
  severity    AlertSeverity
  division    String
  district    String
  thana       String
  latitude    Float
  longitude   Float
  radiusKm    Float          @default(5.0)
  active      Boolean        @default(true)
  broadcastBy String
  createdAt   DateTime       @default(now())
  expiresAt   DateTime?

  @@map("emergency_alerts")
}

model SOSRequest {
  id              String     @id @default(uuid())
  userName        String
  userPhone       String
  userNID         String
  emergencyType   String
  latitude        Float
  longitude       Float
  address         String
  status          SOSStatus  @default(ACTIVE)
  dispatchedUnit  String?
  acknowledgedBy  String?
  createdAt       DateTime   @default(now())
  resolvedAt      DateTime?

  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sos_requests")
}

model ShopReputation {
  id             String    @id @default(uuid())
  shopName       String
  tradeLicenseNo String    @unique
  ownerName      String
  phone          String
  address        String
  marketArea     String
  thana          String
  district       String
  category       String
  totalFinesBDT  Float     @default(0)
  violationCount Int       @default(0)
  trustScore     Int       @default(100)
  isBlacklisted  Boolean   @default(false)
  lastInspection DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  complaints     ConsumerComplaint[]

  @@map("shops")
}

model ConsumerComplaint {
  id                 String             @id @default(uuid())
  shopName           String
  shopAddress        String
  marketArea         String
  thana              String
  district           String
  issueType          ConsumerIssueType
  productName        String
  chargedPrice       Float
  officialPrice      Float?
  description        String
  receiptImageUrl    String?
  status             ComplaintStatus    @default(LODGED)
  fineAmountBDT      Float?
  assignedOfficer    String?
  dncrpHearingDate   DateTime?
  resolutionNotes    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId             String?
  shop               ShopReputation?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@map("consumer_complaints")
}

model BarcodeVerification {
  id                 String   @id @default(uuid())
  barcode            String   @unique
  productName        String
  brand              String
  category           String
  maxRetailPriceBDT  Float
  bstiStandardCode   String
  manufacturer       String
  isBSTIApproved     Boolean  @default(true)
  batchNumber        String
  expiryDate         String
  createdAt          DateTime @default(now())

  @@map("barcode_verifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String
  userRole   String
  action     String
  resource   String
  ipAddress  String?
  details    String
  status     String   @default("SUCCESS")
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model NotificationItem {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
