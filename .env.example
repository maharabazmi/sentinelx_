# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sentinelx_db?schema=public

# Security Clearance Keys
JWT_SECRET=sentinelx-bangladesh-national-security-token-secret-2026
ADMIN_CLEARANCE_KEY=HQ-BANGLADESH-SECURITY-2026

# Email / SMTP Configuration (Gmail)
# To send real emails, generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_letter_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=SentinelX National Command
SMTP_USE_TLS=True

# Server Ports
PORT=5000
FLASK_PORT=5000
FRONTEND_URL=http://localhost:3000

# Gemini AI Copilot Keys (4-Tier Cascade: gemini-2.5-flash -> 2.0-flash -> 2.0-flash-lite -> 1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_BACKUP=optional_backup_gemini_api_key_here

